# GEMINI_API_KEY: Required for server-side Gemini AI Learning Assistant calls.
# Configured in AI Studio Secrets panel or local environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL for the application (used for links and OAuth callbacks).
APP_URL="http://localhost:3000"

# AUTH_SECRET: Secret key used to sign session tokens and verification links.
AUTH_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# PRODUCT CONFIGURATION (Overridable via Admin Settings or Env)
PRODUCT_NAME="Braincode"
PRODUCT_TAGLINE="Learn. Build. Innovate. Grow."
COMPANY_NAME="BrainCode Technology Limited"
SUPPORT_EMAIL="support@braincode.dev"
OFFICIAL_CONTACT_EMAIL=""
BUSINESS_PHONE=""
WHATSAPP_URL=""
BUSINESS_ADDRESS=""
OFFICE_HOURS=""

# OPTIONAL SMTP EMAIL DELIVERY FOR CONTACT ENQUIRIES
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# OAUTH PROVIDERS (Leave blank if not yet configured; UI reflects real availability)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""

# PAYMENTS & SUBSCRIPTIONS (stripe | sandbox)
# When STRIPE_SECRET_KEY is not set, billing operates in explicit Development Sandbox mode.
PAYMENT_PROVIDER="sandbox"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI ASSISTANT CONTROLS
AI_MODEL="gemini-4-hydrogen"
AI_DAILY_FREE_LIMIT="15"
AI_DAILY_PREMIUM_LIMIT="250"

# REMOTE CODE EXECUTION SANDBOX (Optional isolated container runner for Python/Node/Go)
# Browser HTML/CSS/JS execution runs safely in a sandboxed iframe locally.
CODE_SANDBOX_URL=""
